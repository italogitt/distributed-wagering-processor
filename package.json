{
  "name": "wagering-processor",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:integration": "bun test --preload ./test/integration/support/setup.ts ./test/integration/*.integration.ts",
    "test:watch": "bun test --watch",
    "orm": "bunx --bun mikro-orm",
    "migration:create": "bunx --bun mikro-orm migration:create",
    "migration:up": "bunx --bun mikro-orm migration:up",
    "migration:down": "bunx --bun mikro-orm migration:down",
    "migration:check": "bunx --bun mikro-orm migration:check",
    "db:up": "docker compose up -d --wait postgres localstack"
  },
  "mikro-orm": {
    "configPaths": ["./src/infrastructure/persistence/mikro-orm.config.ts"]
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1160.0",
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/decorators": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "prom-client": "15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.2.5",
    "@types/bun": "^1.4.4",
    "typescript": "5.9.3"
  }
}
